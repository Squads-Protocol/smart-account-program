{
  "private": true,
  "workspaces": [
    "sdk/smart-account"
  ],
  "scripts": {
    "build": "turbo run build",
    "test:detached": "turbo run build && anchor test --detach -- --features=testing && echo \"\n⚠️ Don't forget to recompile the .so file before deployment\n\"",
    "test": "turbo run build && anchor test -- --features=testing && echo \"\n⚠️ Don't forget to recompile the .so file before deployment\n\"",
    "pretest": "mkdir -p target/deploy && cp ./test-program-keypair.json ./target/deploy/squads_smart_account_program-keypair.json",
    "ts": "turbo run ts && yarn tsc --noEmit",
    "generate:sdk": "tsx codama/codama.ts",
    "build:sdk:ts": "cd sdk/ts && npm install --silent && npm run build",
    "build:sdk:rust": "cd sdk/rust && cargo build"
  },
  "devDependencies": {
    "@codama/nodes-from-anchor": "^1.2.0",
    "@codama/renderers-js": "^2.2.0",
    "@codama/renderers-rust": "^3.1.0",
    "@solana/spl-memo": "^0.2.3",
    "@solana/spl-token": "*",
    "@types/mocha": "10.0.1",
    "@types/node-fetch": "2.6.2",
    "codama": "^1.6.0",
    "mocha": "10.2.0",
    "prettier": "2.6.2",
    "ts-node": "10.9.1",
    "tsx": "^4.21.0",
    "turbo": "1.6.3",
    "typescript": "*"
  },
  "resolutions": {
    "@solana/web3.js": "1.70.3",
    "@solana/spl-token": "0.3.6",
    "typescript": "4.9.4"
  },
  "packageManager": "yarn@3.5.0",
  "dependencies": {
    "@solana/web3.js": "^1.95.5",
    "@sqds/smart-account": "workspace:^"
  }
}
